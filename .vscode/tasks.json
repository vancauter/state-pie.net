{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Solution",
            "type": "shell",
            "command": "dotnet build *.sln",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run Dev Project",
            "type": "shell",
            "command": "dotnet run --verbosity q --project dev/*.Dev.csproj",
            "group": "none",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run Dev Project (watch)",
            "type": "shell",
            "command": "dotnet watch run --verbosity q --project dev/*.Dev.csproj",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "dotnet test tests/*.Tests.csproj",
            "group": "test",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run Tests (no-build)",
            "type": "shell",
            "command": "dotnet test tests/*.Tests.csproj --no-build",
            "group": "test",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Proper Clean",
            "type": "shell",
            "command": "../proper_clean.sh",
            "group": "none",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
