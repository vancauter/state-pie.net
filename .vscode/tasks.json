{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format Solution",
            "type": "shell",
            "command": "dotnet format whitespace StatePie.sln --include src tests examples",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Lint Solution",
            "type": "shell",
            "command": "dotnet format style StatePie.sln --include src tests examples --verify-no-changes --no-restore --severity warn",
            "group": "test",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Lint Fix Solution",
            "type": "shell",
            "command": "dotnet format style StatePie.sln --include src tests examples --no-restore --severity warn",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Build Solution",
            "type": "shell",
            "command": "dotnet build StatePie.sln",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "dotnet test tests/StatePie.Tests.csproj",
            "group": "test",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
