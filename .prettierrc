{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc", "*.code-workspace", "*rc"],
            "options": {
                "singleQuote": false,
                "trailingComma": "none"
            }
        }
    ]
}
