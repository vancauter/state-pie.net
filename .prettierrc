{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc"],
            "options": {
                "singleQuote": false,
                "parser": "json",
                "trailingComma": "none"
            }
        },
        {
            "files": ["*.md"],
            "options": {
                "proseWrap": "always"
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "singleQuote": false
            }
        }
    ]
}
