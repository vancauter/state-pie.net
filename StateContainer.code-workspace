{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        // "dotnet.defaultSolution": ".sln",
        "dotnet.automaticallyCreateSolutionInWorkspace": true,
        "explorer.compactFolders": false,

        // --- GitHub Copilot Settings ---
        "github.copilot.chat.codeGeneration.useInstructionFiles": true,
        "editor.inlineSuggest.syntaxHighlightingEnabled": false,
        // "editor.inlineSuggest.minShowDelay": 1000,

        // --- File Exclusions ---
        "files.exclude": {
            // Build Artifacts
            "**/bin": true,
            "**/obj": true,

            // IDE Specific
            "**/.vs": true,
            "**/.idea": true,

            // Configuration directories
            "**/.github": false,
            "**/.vscode": false,

            // Configuration files
            "**/*config": true,
            "**/*ignore": true,
            "**/.*rc": true,

            // Documentation files
            "**/LICENSE*": true,
            "**/README*": true,
            "**/cspell.config.yaml": true,

            // Project files
            "**/*.code-workspace": false,
            "**/*.csproj": false,
            "**/*.sln": false,

            // Focus directories
            "**/dev": false,
            "**/docs": false,
            "**/src": false,
            "**/tests": false
        }
    }
}
